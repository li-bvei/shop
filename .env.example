# Read by `docker compose` itself (not by Django) to bootstrap the `db`
# service in docker-compose.yml. Copy to `.env` in this same directory and
# fill in real values — MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD here must
# match DB_NAME/DB_USER/DB_PASSWORD in store-admin-backend/.env exactly,
# since that's the database/user this container actually creates on first
# boot.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=shop
MYSQL_USER=shop
MYSQL_PASSWORD=change-me
