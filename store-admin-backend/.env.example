SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=store_admin
DB_USER=root
DB_PASSWORD=
# Plain local dev: 127.0.0.1. Docker Compose setup (docker-compose.yml):
# `db` — the compose service name for the bundled MySQL 8.0 container (see
# the root .env.example for that container's own bootstrap credentials,
# which DB_NAME/DB_USER/DB_PASSWORD here must match).
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Production-only — leave unset (or False/0) for local dev over plain HTTP.
# See "Deploying to production" in README.md before setting these.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
